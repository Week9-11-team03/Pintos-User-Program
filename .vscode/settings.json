{
  "terminal.integrated.profiles.linux": {
    "bash-with-activate": {
      "path": "bash",
      "args": ["--rcfile", "${workspaceFolder}/.vscode/bash-with-activate"]
    }
  },
  "terminal.integrated.defaultProfile.linux": "bash-with-activate",
  "files.associations": {
    "mmu.h": "c",
    "palloc.h": "c",
    "atomic": "c",
    "synch.h": "c",
    "flags.h": "c",
    "thread.h": "c",
    "*.inc": "c"
  }
}